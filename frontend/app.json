{
  "expo": {
    "name": "CampusOne",
    "slug": "campusone",
    "scheme": "campusone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A36A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusone.app"
    },
    "android": {
      "backgroundColor": "#F8FAFC",
      "package": "com.campusone.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#16A36A"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#16A36A",
          "defaultChannel": "campusone",
          "sounds": []
        }
      ]
    ],
    "notification": {
      "color": "#16A36A",
      "androidMode": "default"
    }
  }
}
